# ─────────────────────────────────────────────────────────────────────
# Mobile client (Expo) — these variables are bundled into the app and
# must be prefixed with EXPO_PUBLIC_ to be exposed to React Native code.
#
# First-time setup: copy this file to .env (git does not include .env):
#   cp .env.example .env        # macOS/Linux
#   copy .env.example .env      # Windows
# Then restart Expo: npx expo start -c
# ─────────────────────────────────────────────────────────────────────
# Skip sign-in for local dev (no Google/Firebase OAuth keys needed on your machine)
EXPO_PUBLIC_BYPASS_AUTH=true

# API URL (optional — defaults to https://buddywalk.app)
# Do NOT use localhost on a physical phone (localhost is the phone itself).
# Leave unset to use production, or use your computer's LAN IP for local server:
# EXPO_PUBLIC_API_URL=http://192.168.1.50:8000

# Companion API (optional — defaults to buddywalk.app in buddy-walk-default-api.json)
# EXPO_PUBLIC_COMPANION_API_URL=http://192.168.1.223:8000
# Public URL caretakers open in a browser (required when API is on a LAN IP)
# EXPO_PUBLIC_COMPANION_SHARE_URL=https://buddywalk.app

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ─────────────────────────────────────────────────────────────────────
# Backend (mobile/server) — required to run `npm run serve` locally
# or in Docker. These are NOT bundled into the mobile client.
# ─────────────────────────────────────────────────────────────────────

# HTTP server
PORT=8000
NODE_ENV=development
# Comma-separated list of origins allowed in production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# MongoDB
# In dev the server falls back to mongodb://127.0.0.1/vlm_dev when NODE_ENV !== production
WEB_LINK=
TEST=local

# OpenAI / Gemini (Gemini falls back to OPENAI_API_KEY if unset)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Google Maps (Geocoding, Places, Street View, Directions)
GOOGLE_API_KEY=

# MTA GTFS-realtime (subway arrival times)
MTA_API_KEY=

# Azure Cognitive Services (used by /api/token for client speech-to-text)
AZURE_SUBSCRIPTION_KEY=
AZURE_REGION=

# Doorfront panorama database (optional; used by services/doorfront.ts)
DOORFRONT_URI=
